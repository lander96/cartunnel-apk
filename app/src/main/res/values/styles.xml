<?xml version="1.0" ?>
<resources>
    <style name="Theme.CarTunnel" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:textSize">@dimen/type_body</item>
        <item name="buttonStyle">@style/CarButton</item>
        <item name="editTextStyle">@style/CarInput</item>
        <item name="checkboxStyle">@style/CarCheckBox</item>
    </style>
    <style name="CarButton" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">@dimen/type_body</item>
        <item name="android:background">@drawable/button_secondary</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">@dimen/control_gap</item>
        <item name="android:paddingEnd">@dimen/control_gap</item>
        <item name="android:layout_marginTop">@dimen/control_gap</item>
    </style>
    <style name="CarPrimary" parent="CarButton">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:minHeight">@dimen/primary_height</item>
    </style>
    <style name="CarInput" parent="Widget.AppCompat.EditText">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">@dimen/type_body</item>
        <item name="android:singleLine">true</item>
        <item name="android:selectAllOnFocus">false</item>
    </style>
    <style name="CarCheckBox" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">@dimen/type_body</item>
    </style>
    <style name="CarTitle">
        <item name="android:textSize">@dimen/type_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:accessibilityHeading">true</item>
    </style>
    <style name="CarSection" parent="CarTitle">
        <item name="android:textSize">@dimen/type_data</item>
        <item name="android:layout_marginTop">@dimen/section_gap</item>
    </style>
</resources>
